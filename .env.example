# 复制为仓库根目录 .env 后填写。不要提交 .env。
# PHP 从环境变量或该文件读取；已设置的环境变量优先。

# 管理员登录（必填，且不能使用示例占位符或曾经公开的默认口令）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NICKNAME=超级管理员

# 登录令牌签名密钥，至少 16 位随机字符串
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=86400

# 公开商务联系邮箱。发布达到上限时展示，请保留。
CONTACT_EMAIL=chigua517@outlook.com

# 预留。当前版本使用 JSON 文件存储，不连接数据库。
# DB_HOST=localhost
# DB_USER=
# DB_PASS=
# DB_NAME=
